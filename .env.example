ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_USER=memory_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=memory_pulse

DATABASE_URL=postgresql+asyncpg://memory_user:your_postgres_password_here@db:5432/memory_pulse

REDIS_BROKER_URL=redis://redis-broker:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

API_USERNAME=admin
API_PASSWORD=your_admin_password_here

GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here

SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_MAX_RETRIES=3
