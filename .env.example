ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

POSTGRES_USER=memory_user
POSTGRES_PASSWORD=memory_pass
POSTGRES_DB=memory_pulse

DATABASE_URL=postgresql+asyncpg://memory_user:memory_pass@db:5432/memory_pulse

REDIS_BROKER_URL=redis://redis-broker:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0

SECRET_KEY=change-me-in-production-use-secrets-module

SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_MAX_RETRIES=3